# Genera una clave segura localmente antes de habilitar sesiones JWT.
AUTH_JWT_SECRET=

# URL de PostgreSQL; configura el valor real solo en .env.local.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/Tienda_Rouse"

# Debe coincidir con DATABASE_URL y apuntar a la misma base local/de pruebas.
TEST_DATABASE_URL=